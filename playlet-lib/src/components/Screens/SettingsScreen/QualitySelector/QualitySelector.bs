import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/parts/AutoBind/OnNodeReadyNoOp.bs"
import "pkg:/source/utils/CodecCapabilities.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/MathUtils.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.checkList = m.top.findNode("checkList")
    m.closeButton = m.top.findNode("closeButton")
    m.saveButton = m.top.findNode("saveButton")
    m.embeddedCloseTimer = m.top.findNode("embeddedCloseTimer")

    SetNavigation(m.checkList, RemoteKeys.Down, m.saveButton)
    SetNavigation(m.saveButton, RemoteKeys.Up, m.checkList)
    SetNavigation(m.closeButton, RemoteKeys.Up, m.checkList)
    SetNavigation(m.saveButton, RemoteKeys.Right, m.closeButton)
    SetNavigation(m.closeButton, RemoteKeys.Left, m.saveButton)

    m.saveButton.observeField("buttonSelected", FuncName(OnSaveButtonSelected))
    m.closeButton.observeField("buttonSelected", FuncName(Close))
    m.checkList.observeField("navKey", FuncName(OnCheckListNav))
    m.saveButton.observeField("navKey", FuncName(OnActionButtonNav))
    m.closeButton.observeField("navKey", FuncName(OnActionButtonNav))
    m.embeddedCloseTimer.observeField("fire", FuncName(OnEmbeddedCloseTimer))

    AddHighQualityOptions()

    m.lastCheckedState = NewCheckedState(false, false)
    m.checkList.observeField("checkedState", FuncName(OnCheckedStateChange))

    SetButtonPositions()
end function

' 1440p/2160p exist on YouTube only as AV1 (mp4) and VP9 (webm) streams, and the
' player only plays fragmented MP4 in DASH, so the options only work with an AV1 decoder.
function AddHighQualityOptions() as void
    if not CodecCapabilities.CanDecodeAv1()
        return
    end if

    content = m.checkList.content
    for each quality in ["1440p", "2160p"]
        node = CreateObject("roSGNode", "ContentNode")
        node.id = quality
        node.title = quality
        content.insertChild(node, 1)
    end for
end function

function NewCheckedState(autoChecked as boolean, othersChecked as boolean) as object
    checkedState = [autoChecked]
    count = m.checkList.content.getChildCount()
    for i = 1 to count - 1
        checkedState.push(othersChecked)
    end for
    return checkedState
end function

function AllQualitiesValue() as string
    values = []
    checkboxes = m.checkList.content.getChildren(-1, 0)
    for i = 1 to checkboxes.Count() - 1
        values.push(checkboxes[i].id)
    end for
    return values.Join(",")
end function

function SetButtonPositions()
    saveButtonWidth = m.saveButton.width
    closeButtonWidth = m.closeButton.width
    buttonsWith = closeButtonWidth + saveButtonWidth + 20
    m.saveButton.translation = [780 / 2 - buttonsWith / 2, m.saveButton.translation[1]]
    m.closeButton.translation = [780 / 2 + buttonsWith / 2 - closeButtonWidth, m.closeButton.translation[1]]
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if

    ' Always open on Auto so the vertical list and its navigation direction are immediately obvious.
    m.checkList.itemFocused = 0
    m.checkList.jumpToItem = 0
    NodeSetFocus(m.checkList, true)
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if NavigationKeyHandler(key, press).handled
        return true
    end if

    if key = RemoteKeys.Options
        if m.top.embedded
            ' Options remains a quick Save/Close toggle and must not minimize the video underneath this modal.
            if m.closeButton.isInFocusChain()
                NodeSetFocus(m.closeButton, false)
                NodeSetFocus(m.saveButton, true)
            else
                NodeSetFocus(m.checkList, false)
                NodeSetFocus(m.saveButton, false)
                NodeSetFocus(m.closeButton, true)
            end if
            return true
        end if
        ' The standalone settings screen keeps its historic AppController pass-through behavior.
        return false
    end if

    if key = RemoteKeys.Play or key = RemoteKeys.Pause or key = RemoteKeys.PlayOnly
        ' Playback remains a pass-through so the player can pause/resume under either hosting mode.
        return false
    end if

    if key = RemoteKeys.Back and press
        Close()
        return true
    end if

    return true
end function

function OnValueChange() as void
    content = m.checkList.content
    value = m.top.value

    if content = invalid or content.getChildCount() = 0
        return
    end if

    values = value.Split(",")
    valuesDict = {}
    for each value in values
        valuesDict[value] = true
    end for

    checkboxes = content.getChildren(-1, 0)
    checkedState = []
    for i = 0 to checkboxes.Count() - 1
        checkedState.push(valuesDict.DoesExist(checkboxes[i].id))
    end for
    ' This is a projection of an existing preference, not a user gesture. Seed the comparison state before
    ' writing the CheckList so changing from auto -> a manual set is not mistaken for "Auto was unchecked"
    ' (the interactive shortcut that intentionally selects every manual quality).
    m.lastCheckedState = checkedState
    m.checkList.checkedState = checkedState
end function

function OnCheckListNav(event as object) as void
    if ValidString(event.GetData()) <> RemoteKeys.Down
        return
    end if

    NodeSetFocus(m.checkList, false)
    NodeSetFocus(m.saveButton, true)
end function

function OnActionButtonNav(event as object) as void
    button = event.GetRoSGNode()
    key = ValidString(event.GetData())
    if button = invalid
        return
    end if

    NodeSetFocus(button, false)
    if key = RemoteKeys.Up
        NodeSetFocus(m.checkList, true)
    else if key = RemoteKeys.Back
        Close()
    else if button.isSameNode(m.closeButton)
        NodeSetFocus(m.saveButton, true)
    else
        NodeSetFocus(m.closeButton, true)
    end if
end function

function OnCheckedStateChange() as void
    content = m.checkList.content
    if content = invalid or content.getChildCount() = 0
        return
    end if

    checkedState = m.checkList.checkedState
    if checkedState = invalid or checkedState.Count() = 0
        return
    end if
    lastCheckedState = m.lastCheckedState
    m.lastCheckedState = checkedState

    autoChanged = lastCheckedState[0] <> checkedState[0]
    hasAuto = checkedState[0]

    if autoChanged
        if hasAuto
            checkedState = NewCheckedState(true, false)
            m.lastCheckedState = checkedState
            m.checkList.checkedState = checkedState
            m.top.value = "auto"
            return
        else
            checkedState = NewCheckedState(false, true)
            m.lastCheckedState = checkedState
            m.checkList.checkedState = checkedState
            m.top.value = AllQualitiesValue()
            return
        end if
    end if

    values = []
    checkboxes = content.getChildren(-1, 0)

    hasNonAuto = false
    for i = 0 to checkboxes.Count() - 1
        if not checkedState[i]
            continue for
        end if
        values.push(checkboxes[i].id)
        if i <> 0
            hasNonAuto = true
        end if
    end for

    if values.Count() = 0
        checkedState = NewCheckedState(true, false)
        m.lastCheckedState = checkedState
        m.checkList.checkedState = checkedState
        m.top.value = "auto"
        return
    end if

    if hasNonAuto and hasAuto
        checkedState[0] = false
        m.lastCheckedState = checkedState
        m.checkList.checkedState = checkedState
        values.shift()
    end if

    m.top.value = values.Join(",")
end function

function OnSaveButtonSelected()
    OnCheckedStateChange()
    m.top.save = true
    Close()
end function

function Close() as void
    ' Release the selector's focus before either host removes it. In embedded mode the closed observer is the
    ' ownership boundary: the player removes this node and restores its own virtual-focus tier. Standalone
    ' settings retain the existing AppController navigation stack behavior.
    focusedChild = m.top.focusedChild
    if focusedChild <> invalid and not focusedChild.isSameNode(m.top)
        NodeSetFocus(focusedChild, false)
    end if
    m.top.focus = false

    if m.top.embedded
        ' Finish after the current key dispatch unwinds. Removing this modal synchronously from its own Back/OK
        ' handler can let that same key fall through to the newly exposed player (Back immediately hid the HUD).
        m.embeddedCloseTimer.control = "stop"
        m.embeddedCloseTimer.control = "start"
        return
    end if
    m.appController@.PopScreen()
end function

function OnEmbeddedCloseTimer() as void
    m.top.closed = true
end function
