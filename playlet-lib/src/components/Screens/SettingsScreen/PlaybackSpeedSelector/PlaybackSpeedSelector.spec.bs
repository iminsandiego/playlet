import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/RemoteKeys.bs"

namespace Tests

    @SGNode("PlaybackSpeedSelectorTestHarness")
    @suite
    class PlaybackSpeedSelectorTests extends Rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.options = [
                { displayText: "0.5x", value: "0.5" }
                { displayText: "1x", value: "1.0" }
                { displayText: "1.5x", value: "1.5" }
            ]
            m.top.embedded = true
            m.top.save = false
            m.top.closed = false
            m.top.value = "1.0"
            m.top.focus = true
        end function

        @describe("modal selection behavior")

        @it("shows one compact list and saves the selected speed")
        function _()
            m.assertEqual(m.top.findNode("title").text, Tr(Locale.Settings.DefaultPlaybackSpeed))
            speedList = m.top.findNode("speedList")
            m.assertEqual(speedList.content.getChildCount(), 3)
            m.assertEqual(speedList.checkedItem, 1)
            m.assertEqual(speedList.itemFocused, 1)

            speedList.checkedItem = 2
            m.assertTrue(m.top.save)
            m.assertEqual(m.top.value, "1.5")
            m.assertFalse(m.top.closed, "close is deferred until the activating key unwinds")

            m.top.callFunc("TestCompleteClose")
            m.assertTrue(m.top.closed)
            m.assertFalse(m.top.focus)
        end function

        @it("saves the exact value for every displayed speed including fractional rates")
        function _()
            values = ["0.25", "0.5", "0.75", "1.0", "1.25", "1.5", "1.75", "2.0"]
            labels = ["0.25x", "0.5x", "0.75x", "1x", "1.25x", "1.5x", "1.75x", "2x"]
            options = []
            for i = 0 to values.Count() - 1
                options.Push({ displayText: labels[i], value: values[i] })
            end for
            m.top.options = options
            speedList = m.top.findNode("speedList")
            m.assertEqual(speedList.content.getChildCount(), 8)
            for i = 0 to values.Count() - 1
                m.top.save = false
                m.top.closed = false
                m.assertEqual(speedList.content.getChild(i).title, labels[i])
                speedList.checkedItem = i
                m.assertTrue(m.top.save, labels[i])
                m.assertEqual(m.top.value, values[i])
                m.top.callFunc("TestCompleteClose")
                m.assertTrue(m.top.closed)
            end for
        end function

        @it("accepts a contextual title when embedded in the player")
        function _()
            m.top.title = "Speed for this video"
            m.assertEqual(m.top.findNode("title").text, "Speed for this video")
        end function

        @it("back closes without changing or saving the preference")
        function _()
            m.assertTrue(m.top.callFunc("TestKey", RemoteKeys.Back, true))
            m.top.callFunc("TestCompleteClose")

            m.assertFalse(m.top.save)
            m.assertEqual(m.top.value, "1.0")
            m.assertTrue(m.top.closed)
        end function

        @it("passes playback keys through to the hosting player")
        function _()
            m.assertFalse(m.top.callFunc("TestKey", RemoteKeys.Play, true))
            m.assertFalse(m.top.callFunc("TestKey", RemoteKeys.Pause, true))
            m.assertFalse(m.top.callFunc("TestKey", RemoteKeys.PlayOnly, true))
            m.assertFalse(m.top.save)
            m.assertFalse(m.top.closed)
        end function

    end class

end namespace
