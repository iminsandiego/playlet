import "pkg:/components/VideoPlayerDev/PlayerCoordinatorLogic.bs"
import "pkg:/components/VideoPlayerDev/TransportController.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Types.bs"

' Trackbar track spans x=68..1212: right cluster right-aligns to 1212, center cluster centers on 640.
const ROW_Y = 560
const BUTTON_WIDTH = 42
const BUTTON_SPACING = 20
const SCREEN_CENTER_X = 640
const TRACKBAR_RIGHT_X = 1212

function Init()
    ' Focus order MUST match PlayerCoordinatorLogic.PlayerButton.
    m.buttons = [
        m.top.findNode("PreviousButton")
        m.top.findNode("PlayPauseButton")
        m.top.findNode("NextButton")
        m.top.findNode("QualityButton")
        m.top.findNode("SpeedButton")
        m.top.findNode("CaptionsButton")
        m.top.findNode("StatsButton")
        m.top.findNode("BookmarkButton")
        m.top.findNode("MinimizeButton")
    ]
    m.focusLabel = m.top.findNode("FocusLabel")
    m.centerCluster = m.top.findNode("CenterCluster")
    m.rightCluster = m.top.findNode("RightCluster")
    LayoutClusters()
    m.top.buttonCount = m.buttons.Count() ' coordinator reads this to clamp focus

    for each field in ["transportMode", "rowFocused", "focusedIndex", "playing", "previousEnabled", "nextEnabled", "qualityLabel", "qualityDescription", "speedLabel", "speedEnabled", "captionsEnabled", "statsEnabled", "bookmarkAvailable", "bookmarked"]
        m.top.ObserveField(field, FuncName(Repaint))
    end for
    m.top.ObserveField("nudge", FuncName(OnNudge))
    Repaint()
end function

' Forward the nudge to the focused button (an out-of-range focusedIndex indexes to invalid -> no-op).
function OnNudge() as void
    button = m.buttons[m.top.focusedIndex]
    if button <> invalid
        button.nudge = true
    end if
end function

' Position the buttons inside each cluster and the clusters on screen, all from child count, so adding a
' button auto-positions without hardcoded offsets.
function LayoutClusters() as void
    LayoutButtons(m.centerCluster)
    LayoutButtons(m.rightCluster)
    m.centerCluster.translation = [SCREEN_CENTER_X - ClusterWidth(m.centerCluster) / 2, ROW_Y]
    m.rightCluster.translation = [TRACKBAR_RIGHT_X - ClusterWidth(m.rightCluster), ROW_Y]
end function

function LayoutButtons(cluster as object) as void
    x = 0
    for i = 0 to cluster.getChildCount() - 1
        button = cluster.getChild(i)
        button.translation = [x, 0]
        x += ButtonWidth(button) + BUTTON_SPACING
    end for
end function

function ClusterWidth(cluster as object) as integer
    n = cluster.getChildCount()
    if n <= 0
        return 0
    end if
    width = (n - 1) * BUTTON_SPACING
    for i = 0 to n - 1
        width += ButtonWidth(cluster.getChild(i))
    end for
    return width
end function

function ButtonWidth(button as object) as integer
    if button.hasField("buttonWidth")
        width = ValidInt(button.buttonWidth)
        if width > 0
            return width
        end if
    end if
    return BUTTON_WIDTH
end function

function Repaint() as void
    ' Hide the row while a transport is active so it's out of the way during seeking. Chrome show/hide
    ' fades the parent group, so visible=true with a hidden parent stays unpainted.
    m.top.visible = (m.top.transportMode = TransportController.Mode.Idle)

    m.buttons[0].disabled = not m.top.previousEnabled
    m.buttons[1].toggleState = not m.top.playing ' toggleState false = pause icon, true = play icon
    m.buttons[2].disabled = not m.top.nextEnabled
    m.buttons[3].text = m.top.qualityLabel
    m.buttons[4].text = m.top.speedLabel
    m.buttons[4].disabled = not m.top.speedEnabled
    m.buttons[5].toggleState = not m.top.captionsEnabled ' toggleState false = cc-on icon
    m.buttons[5].active = m.top.captionsEnabled
    m.buttons[6].toggleState = not m.top.statsEnabled ' toggleState false = stats-on icon
    m.buttons[6].active = m.top.statsEnabled
    m.buttons[7].disabled = not m.top.bookmarkAvailable
    m.buttons[7].active = m.top.bookmarked

    for i = 0 to m.buttons.Count() - 1
        m.buttons[i].focused = m.top.rowFocused and i = m.top.focusedIndex
    end for
    m.focusLabel.visible = m.top.rowFocused
    if m.top.rowFocused
        m.focusLabel.text = FocusLabelFor(m.top.focusedIndex)
    end if
end function

function FocusLabelFor(index as integer) as string
    if index = PlayerCoordinatorLogic.PlayerButton.Previous
        return Tr(Locale.VideoPlayer.PreviousVideo)
    else if index = PlayerCoordinatorLogic.PlayerButton.PlayPause
        if m.top.playing
            return Tr(Locale.VideoPlayer.Pause)
        end if
        return Tr(Locale.VideoPlayer.Play)
    else if index = PlayerCoordinatorLogic.PlayerButton.NextVideo
        return Tr(Locale.VideoPlayer.NextVideo)
    else if index = PlayerCoordinatorLogic.PlayerButton.Quality
        return Tr(Locale.Settings.DefaultQuality) + ": " + m.top.qualityDescription
    else if index = PlayerCoordinatorLogic.PlayerButton.PlaybackSpeed
        return Tr(Locale.VideoPlayer.SpeedForThisVideo) + ": " + m.top.speedLabel
    else if index = PlayerCoordinatorLogic.PlayerButton.Captions
        if m.top.captionsEnabled
            return Tr(Locale.VideoPlayer.TurnCaptionsOff)
        end if
        return Tr(Locale.VideoPlayer.TurnCaptionsOn)
    else if index = PlayerCoordinatorLogic.PlayerButton.Stats
        if m.top.statsEnabled
            return Tr(Locale.VideoPlayer.HideStatsForNerds)
        end if
        return Tr(Locale.VideoPlayer.ShowStatsForNerds)
    else if index = PlayerCoordinatorLogic.PlayerButton.Bookmark
        if m.top.bookmarked
            return Tr(Locale.VideoPlayer.RemoveBookmark)
        end if
        return Tr(Locale.VideoPlayer.SaveVideo)
    else if index = PlayerCoordinatorLogic.PlayerButton.Minimize
        return Tr(Locale.VideoPlayer.Minimize)
    end if
    return ""
end function
