<component name="ButtonRow" extends="Group">
    <!-- Virtual focus: the coordinator keeps real focus on the Video node and tells this row which button is
         highlighted (focusedIndex) and whether the row has focus (rowFocused). `visible` is gated on idle so the
         row rides the parent Chrome group's opacity fade instead of popping.

         CenterCluster is centered on screen, RightCluster is right-aligned; each is a plain Group whose
         buttons + position are laid out in code from its child count. (Not a LayoutGroup: it re-aligns a child
         whenever its bounding rect changes, which pins the scale pulse's corner and makes it grow off-center.)

         To add a button, do all four or focus/activation breaks:
           1. drop a VideoPlayerButton into a cluster (xml below);
           2. add it (in focus order) to m.buttons in ButtonRow.bs (buttonCount updates automatically);
           3. add a PlayerCoordinatorLogic.PlayerButton enum value (the index);
           4. add an `else if index = PlayerButton.x` case to ActivateButton in VideoPlayerDev.bs. -->
    <interface>
        <field id="transportMode" type="integer" value="0" />
        <field id="rowFocused" type="boolean" value="false" />
        <field id="focusedIndex" type="integer" value="1" />
        <field id="playing" type="boolean" value="true" /> <!-- selects the play vs pause icon -->
        <field id="previousEnabled" type="boolean" value="false" />
        <field id="nextEnabled" type="boolean" value="false" />
        <!-- Current values appear in the playback-settings focus label. -->
        <field id="qualityLabel" type="string" value="" />
        <field id="speedLabel" type="string" value="" />
        <field id="captionsEnabled" type="boolean" value="false" /> <!-- any global mode except Off -->
        <field id="statsEnabled" type="boolean" value="false" /> <!-- selects + accents the stats icon -->
        <field id="bookmarkAvailable" type="boolean" value="false" /> <!-- requires a current videoId -->
        <field id="bookmarked" type="boolean" value="false" />
        <field id="buttonCount" type="integer" value="0" /> <!-- read-only: set in Init from m.buttons -->
        <field id="focusedLabel" type="string" alias="FocusLabel.text" />
        <!-- pulse the focused button's scale nudge (a press that couldn't move focus: Left/Right clamped at
             the row's ends, Up at the top tier). -->
        <field id="nudge" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <!-- Queue + transport controls, centered on screen (x=640). -->
        <Group id="CenterCluster">
            <VideoPlayerButton id="PreviousButton"
                iconUri="pkg:/images/icons/player/previous.png" />
            <VideoPlayerButton id="PlayPauseButton"
                iconUri="pkg:/images/icons/player/play.png"
                iconUri2="pkg:/images/icons/player/pause.png" />
            <VideoPlayerButton id="NextButton"
                iconUri="pkg:/images/icons/player/next.png" />
        </Group>
        <!-- Feature controls, right-aligned to the trackbar's right edge (x=1212). -->
        <Group id="RightCluster">
            <VideoPlayerButton id="PlaybackSettingsButton"
                iconUri="pkg:/images/icons/player/quality.png" />
            <VideoPlayerButton id="CaptionsButton"
                iconUri="pkg:/images/icons/player/cc-off.png"
                iconUri2="pkg:/images/icons/player/cc-on.png" />
            <VideoPlayerButton id="StatsButton"
                iconUri="pkg:/images/icons/player/stats-off.png"
                iconUri2="pkg:/images/icons/player/stats-on.png" />
            <VideoPlayerButton id="BookmarkButton"
                iconUri="pkg:/images/icons/player/bookmark.png" />
            <VideoPlayerButton id="MinimizeButton"
                iconUri="pkg:/images/icons/player/minimize.png" />
        </Group>
        <Label id="FocusLabel" translation="[0,516]" width="1280" height="32"
            visible="false" color="0xFEFEFEFF" horizAlign="center" vertAlign="center">
            <Font role="font" uri="font:MediumSystemFontFile" size="22" />
        </Label>
    </children>
</component>
