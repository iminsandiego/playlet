' ButtonRow @SGNode suite — instantiates just the row, sets its scalar input fields, and asserts the derived
' visibility + the virtual-focus highlight on the child buttons (no coordinator, no Video node).

namespace Tests

    @SGNode("ButtonRow")
    @suite
    class ButtonRowTests extends Rooibos.BaseTestSuite

        protected override function beforeEach()
            m.top.transportMode = TransportController.Mode.Idle
            m.top.rowFocused = false
            m.top.focusedIndex = 1
            m.top.playing = true
            m.top.previousEnabled = false
            m.top.nextEnabled = false
            m.top.qualityLabel = "Auto"
            m.top.speedLabel = "1x"
            m.top.captionsEnabled = false
            m.top.statsEnabled = false
            m.top.bookmarkAvailable = false
            m.top.bookmarked = false
        end function

        @describe("visibility + layout")

        @it("visible at idle (the chrome group's opacity fade does the chrome-gating)")
        function _()
            m.top.transportMode = TransportController.Mode.Idle
            m.assertTrue(m.top.visible)
        end function

        @it("hidden during a transport (gets out of the way of seeking)")
        function _()
            m.top.transportMode = TransportController.Mode.Scrub
            m.assertFalse(m.top.visible)
        end function

        @it("exposes its button count and auto-positions the clusters (centered + right-aligned)")
        function _()
            m.assertEqual(m.top.buttonCount, 8)
            ' The three-button transport cluster centers on 640. The five-button feature cluster
            ' remains right-aligned to 1212.
            m.assertEqual(m.top.findNode("CenterCluster").translation[0], 557.0)
            m.assertEqual(m.top.findNode("RightCluster").translation[0], 922.0)
        end function

        @describe("virtual-focus highlight")

        @it("no button is focused until the row holds focus")
        function _()
            m.top.rowFocused = false
            m.assertFalse(m.top.findNode("PreviousButton").focused)
            m.assertFalse(m.top.findNode("PlayPauseButton").focused)
            m.assertFalse(m.top.findNode("NextButton").focused)
            m.assertFalse(m.top.findNode("PlaybackSettingsButton").focused)
            m.assertFalse(m.top.findNode("CaptionsButton").focused)
            m.assertFalse(m.top.findNode("StatsButton").focused)
            m.assertFalse(m.top.findNode("BookmarkButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
        end function

        @it("the focused button follows focusedIndex while the row holds focus")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = 0
            m.assertTrue(m.top.findNode("PreviousButton").focused)
            m.assertFalse(m.top.findNode("PlayPauseButton").focused)
            m.assertFalse(m.top.findNode("StatsButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
            m.top.focusedIndex = 1
            m.assertFalse(m.top.findNode("PreviousButton").focused)
            m.assertTrue(m.top.findNode("PlayPauseButton").focused)
            m.assertFalse(m.top.findNode("StatsButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
            m.top.focusedIndex = 5
            m.assertFalse(m.top.findNode("PreviousButton").focused)
            m.assertFalse(m.top.findNode("PlayPauseButton").focused)
            m.assertTrue(m.top.findNode("StatsButton").focused)
            m.assertFalse(m.top.findNode("MinimizeButton").focused)
            m.top.focusedIndex = 7
            m.assertFalse(m.top.findNode("PreviousButton").focused)
            m.assertFalse(m.top.findNode("PlayPauseButton").focused)
            m.assertFalse(m.top.findNode("StatsButton").focused)
            m.assertTrue(m.top.findNode("MinimizeButton").focused)
        end function

        @describe("nudge")

        @it("nudge pulses the focused button's animation")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = 7
            anim = m.top.findNode("MinimizeButton").findNode("nudgeAnim")
            anim.control = "stop"
            m.top.nudge = true
            m.assertEqual(anim.control, "start")
        end function

        @it("a nudge with an out-of-range focusedIndex is a safe no-op")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = 10
            playAnim = m.top.findNode("PlayPauseButton").findNode("nudgeAnim")
            statsAnim = m.top.findNode("StatsButton").findNode("nudgeAnim")
            minimizeAnim = m.top.findNode("MinimizeButton").findNode("nudgeAnim")
            playAnim.control = "stop"
            statsAnim.control = "stop"
            minimizeAnim.control = "stop"
            m.top.nudge = true
            m.assertEqual(playAnim.control, "stop")
            m.assertEqual(statsAnim.control, "stop")
            m.assertEqual(minimizeAnim.control, "stop")
        end function

        @describe("queue availability")

        @it("dims unavailable queue controls")
        function _()
            m.top.previousEnabled = false
            m.top.nextEnabled = true
            m.assertTrue(m.top.findNode("PreviousButton").disabled)
            m.assertFalse(m.top.findNode("NextButton").disabled)

            m.top.previousEnabled = true
            m.top.nextEnabled = false
            m.assertFalse(m.top.findNode("PreviousButton").disabled)
            m.assertTrue(m.top.findNode("NextButton").disabled)
        end function

        @describe("play/pause icon tracks the play state")

        @it("shows the pause icon while playing, the play icon while paused")
        function _()
            ' toggleState=false shows icon2 (pause); =true shows icon (play).
            m.top.playing = true
            m.assertFalse(m.top.findNode("PlayPauseButton").toggleState)
            m.top.playing = false
            m.assertTrue(m.top.findNode("PlayPauseButton").toggleState)
        end function

        @describe("stats icon tracks the preference state")

        @it("shows stats-off at rest and stats-on with the active accent when enabled")
        function _()
            stats = m.top.findNode("StatsButton")
            m.top.statsEnabled = false
            m.assertTrue(stats.toggleState)
            m.assertFalse(stats.active)

            m.top.statsEnabled = true
            m.assertFalse(stats.toggleState)
            m.assertTrue(stats.active)
        end function

        @describe("playback settings control")

        @it("uses the standard round button with a recognizable settings icon")
        function _()
            settings = m.top.findNode("PlaybackSettingsButton")
            m.assertEqual(settings.subtype(), "VideoPlayerButton")
            m.assertEqual(settings.iconUri, "pkg:/images/icons/player/quality.png")
        end function

        @describe("focus labels")

        @it("is hidden with the row and describes play/pause state when focused")
        function _()
            m.top.rowFocused = false
            m.assertFalse(m.top.findNode("FocusLabel").visible)

            m.top.rowFocused = true
            m.top.focusedIndex = PlayerCoordinatorLogic.PlayerButton.PlayPause
            m.top.playing = true
            m.assertTrue(m.top.findNode("FocusLabel").visible)
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.Pause))
            m.top.playing = false
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.Play))
        end function

        @it("summarizes quality and speed on playback settings")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = PlayerCoordinatorLogic.PlayerButton.PlaybackSettings
            m.top.qualityLabel = "4K"
            m.top.speedLabel = "1.5x"
            m.assertTrue(m.top.focusedLabel.InStr(Tr(Locale.VideoPlayer.PlaybackSettings)) >= 0)
            m.assertTrue(m.top.focusedLabel.InStr("4K") >= 0)
            m.assertTrue(m.top.focusedLabel.InStr("1.5x") >= 0)
        end function

        @it("describes toggle actions rather than only naming their icons")
        function _()
            m.top.rowFocused = true
            m.top.focusedIndex = PlayerCoordinatorLogic.PlayerButton.Captions
            m.top.captionsEnabled = false
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.TurnCaptionsOn))
            m.top.captionsEnabled = true
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.TurnCaptionsOff))

            m.top.focusedIndex = PlayerCoordinatorLogic.PlayerButton.Stats
            m.top.statsEnabled = false
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.ShowStatsForNerds))
            m.top.statsEnabled = true
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.HideStatsForNerds))

            m.top.focusedIndex = PlayerCoordinatorLogic.PlayerButton.Bookmark
            m.top.bookmarked = false
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.SaveVideo))
            m.top.bookmarked = true
            m.assertEqual(m.top.focusedLabel, Tr(Locale.VideoPlayer.RemoveBookmark))
        end function

        @describe("caption + bookmark state")

        @it("caption mode selects the on glyph and active accent")
        function _()
            captions = m.top.findNode("CaptionsButton")
            m.top.captionsEnabled = false
            m.assertTrue(captions.toggleState)
            m.assertFalse(captions.active)

            m.top.captionsEnabled = true
            m.assertFalse(captions.toggleState)
            m.assertTrue(captions.active)
        end function

        @it("bookmark requires a video and reflects current saved state")
        function _()
            bookmark = m.top.findNode("BookmarkButton")
            m.top.bookmarkAvailable = false
            m.top.bookmarked = true
            m.assertTrue(bookmark.disabled)
            m.assertTrue(bookmark.active)

            m.top.bookmarkAvailable = true
            m.top.bookmarked = false
            m.assertFalse(bookmark.disabled)
            m.assertFalse(bookmark.active)

            m.top.bookmarked = true
            m.assertTrue(bookmark.active)
        end function

    end class

end namespace
