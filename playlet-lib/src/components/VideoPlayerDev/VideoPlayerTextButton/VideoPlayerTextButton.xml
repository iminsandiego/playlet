<component name="VideoPlayerTextButton" extends="Group">
    <!-- Compact value-button companion to VideoPlayerButton. It uses the same 42px circle and
         virtual-focus/disabled/nudge contract as the icon controls. -->
    <interface>
        <field id="buttonWidth" type="integer" value="42" />
        <field id="text" type="string" alias="label.text" />

        <field id="backgroundColor" type="color" value="#3C3C3C" />
        <field id="focusedBackgroundColor" type="color" value="#DDDDDD" />
        <field id="disabledBackgroundColor" type="color" value="#292929" />
        <field id="textColor" type="color" value="#DDDDDD" />
        <field id="focusedTextColor" type="color" value="#262626" />
        <field id="activeTextColor" type="color" value="#FF1C30" />
        <field id="focusedActiveTextColor" type="color" value="#B00014" />
        <field id="disabledTextColor" type="color" value="#707070" />

        <field id="focused" type="boolean" value="false" />
        <field id="active" type="boolean" value="false" />
        <field id="disabled" type="boolean" value="false" />
        <field id="nudge" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Group id="anchor">
            <!-- Keep the artwork square so it renders as the same circle used by the adjacent icon buttons.
                 The label is a sibling overlay because some Roku models do not reliably paint children of Poster. -->
            <Poster id="background" uri="pkg:/images/icons/player/white-circle.png"
                width="42" height="42" blendColor="#3C3C3C" />
            <Label id="label" width="42" height="42" translation="[0,1]"
                horizAlign="center" vertAlign="center">
                <Font role="font" uri="font:SystemFontFile" size="13" />
            </Label>
        </Group>
        <Animation id="nudgeAnim" optional="true" duration="0.15">
            <Vector2DFieldInterpolator id="nudgeScale"
                key="[ 0.0, 0.5, 1.0 ]"
                keyValue="[ [ 1.0, 1.0 ], [ 1.05, 1.05 ], [ 1.0, 1.0 ] ]"
                fieldToInterp="anchor.scale" />
        </Animation>
    </children>
</component>
