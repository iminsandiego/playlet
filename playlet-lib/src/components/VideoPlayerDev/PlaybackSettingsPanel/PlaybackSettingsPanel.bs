import "pkg:/components/VideoPlayerDev/PlayerCoordinatorLogic.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

function Init()
    m.qualityButton = m.top.findNode("qualityButton")
    m.speedButton = m.top.findNode("speedButton")
    m.closeButton = m.top.findNode("playbackSettingsCloseButton")
    m.closeTimer = m.top.findNode("closeTimer")
    m.speedOptions = PlayerCoordinatorLogic.PlaybackSpeedValues()
    m.speedIndex = 3

    m.qualityButton.ObserveField("buttonSelected", FuncName(OnQualitySelected))
    m.speedButton.ObserveField("buttonSelected", FuncName(OnSpeedSelected))
    m.closeButton.ObserveField("buttonSelected", FuncName(Close))
    for each button in [m.qualityButton, m.speedButton, m.closeButton]
        button.ObserveField("navKey", FuncName(OnRowNav))
    end for
    m.closeTimer.ObserveField("fire", FuncName(OnCloseTimer))

    OnSpeedValueChange()
    Repaint()
end function

function OnFocusChange() as void
    if m.top.focus
        FocusButton(m.qualityButton)
    end if
end function

function FocusButton(button as object) as void
    for each item in [m.qualityButton, m.speedButton, m.closeButton]
        NodeSetFocus(item, false)
    end for
    if button <> invalid and not button.disabled
        NodeSetFocus(button, true)
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    if key = RemoteKeys.Play or key = RemoteKeys.Pause or key = RemoteKeys.PlayOnly
        return false
    end if
    if press and key = RemoteKeys.Back
        Close()
    end if
    return true
end function

function OnRowNav(event as object) as void
    button = event.GetRoSGNode()
    key = ValidString(event.GetData())
    if key = RemoteKeys.Back
        Close()
        return
    else if key = RemoteKeys.Options
        FocusButton(m.closeButton)
        return
    end if

    if button.isSameNode(m.speedButton) and (key = RemoteKeys.Left or key = RemoteKeys.Right)
        if key = RemoteKeys.Left
            CycleSpeed(-1)
        else
            CycleSpeed(1)
        end if
        return
    end if

    if key = RemoteKeys.Down
        if button.isSameNode(m.qualityButton)
            if m.top.speedEnabled
                FocusButton(m.speedButton)
            else
                FocusButton(m.closeButton)
            end if
        else
            FocusButton(m.closeButton)
        end if
    else if key = RemoteKeys.Up
        if button.isSameNode(m.closeButton) and m.top.speedEnabled
            FocusButton(m.speedButton)
        else
            FocusButton(m.qualityButton)
        end if
    end if
end function

function OnQualitySelected() as void
    m.top.requestQuality = true
end function

function OnSpeedSelected() as void
    CycleSpeed(1)
end function

function CycleSpeed(direction as integer) as void
    if not m.top.speedEnabled or direction = 0
        return
    end if
    count = m.speedOptions.Count()
    m.speedIndex = (m.speedIndex + direction + count) mod count
    m.top.speedValue = m.speedOptions[m.speedIndex]
    m.top.speedChanged = m.top.speedValue
end function

function OnSpeedValueChange() as void
    value = ValidString(m.top.speedValue)
    index = -1
    for i = 0 to m.speedOptions.Count() - 1
        if value = m.speedOptions[i]
            index = i
            exit for
        end if
    end for
    if index < 0
        index = 3
        m.top.speedValue = m.speedOptions[index]
    end if
    m.speedIndex = index
    Repaint()
end function

function Repaint() as void
    if m.qualityButton = invalid
        return
    end if
    m.qualityButton.text = Tr(Locale.Settings.DefaultQuality) + ":  " + m.top.qualityLabel
    m.speedButton.disabled = not m.top.speedEnabled
    if m.top.speedEnabled
        speedLabel = PlayerCoordinatorLogic.PlaybackSpeedLabel(m.top.speedValue)
        if m.top.speedValue = m.top.speedDefaultValue
            speedLabel += " (" + Tr(Locale.VideoPlayer.Default) + ")"
        end if
        m.speedButton.text = Tr(Locale.VideoPlayer.SpeedForThisVideo) + ":  " + speedLabel
    else
        m.speedButton.text = Tr(Locale.VideoPlayer.SpeedForThisVideo) + ":  " + Tr(Locale.VideoPlayer.SpeedUnavailableLive)
    end if
end function

function Close() as void
    focusedChild = m.top.focusedChild
    if focusedChild <> invalid and not focusedChild.IsSameNode(m.top)
        NodeSetFocus(focusedChild, false)
    end if
    m.top.focus = false
    m.closeTimer.control = "stop"
    m.closeTimer.control = "start"
end function

function OnCloseTimer() as void
    m.top.closed = true
end function
