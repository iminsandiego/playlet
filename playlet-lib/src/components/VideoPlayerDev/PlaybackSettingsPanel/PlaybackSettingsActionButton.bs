import "pkg:/source/utils/RemoteKeys.bs"

' Deterministic modal-row navigation. ButtonEx owns OK; this extension also reports every directional,
' Options, and Back key to the panel so no native focus-boundary behavior can leak to the player.
function OnKeyEvent(key as string, press as boolean) as boolean
    if not press
        return false
    end if

    if key = RemoteKeys.Ok
        if not m.top.disabled
            m.top.buttonSelected = true
        end if
        return true
    else if key = RemoteKeys.Up or key = RemoteKeys.Down or key = RemoteKeys.Left or key = RemoteKeys.Right or key = RemoteKeys.Options or key = RemoteKeys.Back
        m.top.navKey = key
        return true
    end if

    return false
end function
