' Focused pure tests for the dedicated VOD -10/+10 commands. No Video/SceneGraph node is involved: control=None
' is the controller/coordinator contract that preserves playing and paused state across Roku's implicit seek resume.

import "pkg:/components/VideoPlayerDev/TransportController.bs"
import "pkg:/source/tests/VideoPlayerDev/PlayerInvariants.bs"

namespace Tests

    @suite
    class TransportControllerRelativeSeekTests extends Rooibos.BaseTestSuite

        protected override function beforeEach()
            m.t = m.FreshVod(60000, 120000)
        end function

        @describe("dedicated VOD -10/+10 commands")

        @it("seeks back ten seconds immediately without changing playback state")
        function _()
            m.t.HandleCommand(TransportController.Command.SkipBack10)
            intent = m.t.TakeVideoIntent()

            m.assertEqual(intent.control, TransportController.Control.None)
            m.assertTrue(intent.hasSeek)
            m.assertEqual(intent.seekMs, 50000)
            m.assertEqual(m.t.positionMs, 50000)
            m.assertEqual(m.t.cursorMs, 50000)
            m.assertEqual(m.t.transportMode, TransportController.Mode.Idle)
            m.assertTrue(m.t.seekSettling)
            m.AssertInvariants(m.t)
        end function

        @it("seeks ahead ten seconds through the same coordinator-drained intent")
        function _()
            m.t.HandleCommand(TransportController.Command.SkipAhead10)
            intent = m.t.TakeVideoIntent()

            m.assertEqual(intent.control, TransportController.Control.None)
            m.assertTrue(intent.hasSeek)
            m.assertEqual(intent.seekMs, 70000)
            m.assertEqual(m.t.positionMs, 70000)
            m.assertEqual(m.t.cursorMs, 70000)
            m.AssertInvariants(m.t)
        end function

        @it("accumulates rapid presses from the optimistic target instead of stale device position")
        function _()
            m.t.HandleCommand(TransportController.Command.SkipAhead10)
            m.assertEqual(m.t.TakeVideoIntent().seekMs, 70000)
            m.t.HandleCommand(TransportController.Command.SkipAhead10)
            m.assertEqual(m.t.TakeVideoIntent().seekMs, 80000)

            m.t.HandleCommand(TransportController.Command.SkipBack10)
            m.assertEqual(m.t.TakeVideoIntent().seekMs, 70000)
            m.assertEqual(m.t.positionMs, 70000)
            m.assertEqual(m.t.cursorMs, 70000)
            m.AssertInvariants(m.t)
        end function

        @it("clamps both commands to the VOD bounds")
        function _()
            back = m.FreshVod(5000, 120000)
            back.HandleCommand(TransportController.Command.SkipBack10)
            m.assertEqual(back.TakeVideoIntent().seekMs, 0)
            m.assertEqual(back.cursorMs, 0)
            m.AssertInvariants(back)

            ahead = m.FreshVod(115000, 120000)
            ahead.HandleCommand(TransportController.Command.SkipAhead10)
            m.assertEqual(ahead.TakeVideoIntent().seekMs, 120000)
            m.assertEqual(ahead.cursorMs, 120000)
            m.AssertInvariants(ahead)
        end function

        @it("emits no redundant seek when already at the requested boundary")
        function _()
            atStart = m.FreshVod(0, 120000)
            m.assertFalse(atStart.SeekBy(-TransportController.SKIP_10_SECONDS_MS))
            m.assertInvalid(atStart.TakeVideoIntent())

            atEnd = m.FreshVod(120000, 120000)
            m.assertFalse(atEnd.SeekBy(TransportController.SKIP_10_SECONDS_MS))
            m.assertInvalid(atEnd.TakeVideoIntent())
        end function

        @it("drops input before ready or before duration is known")
        function _()
            notReady = new TransportController.Controller()
            notReady.SetContent(false, 2000, true)
            notReady.OnDuration(120000)
            notReady.OnPosition(60000)
            notReady.HandleCommand(TransportController.Command.SkipAhead10)
            m.assertInvalid(notReady.TakeVideoIntent())

            noDuration = new TransportController.Controller()
            noDuration.SetContent(false, 2000, true)
            noDuration.OnPosition(60000)
            noDuration.OnReady()
            m.assertFalse(noDuration.SeekBy(TransportController.SKIP_10_SECONDS_MS))
            m.assertInvalid(noDuration.TakeVideoIntent())
        end function

        @it("rejects the one-shot command during an active preview transport")
        function _()
            m.t.HandleCommand(TransportController.Command.Right)
            freezeIntent = m.t.TakeVideoIntent()
            m.assertEqual(freezeIntent.control, TransportController.Control.Pause)
            cursor = m.t.cursorMs

            m.assertFalse(m.t.SeekBy(TransportController.SKIP_10_SECONDS_MS))
            m.assertInvalid(m.t.TakeVideoIntent())
            m.assertEqual(m.t.transportMode, TransportController.Mode.Scrub)
            m.assertEqual(m.t.cursorMs, cursor)
            m.AssertInvariants(m.t)
        end function

        @describe("live policy")

        @it("leaves live playback untouched so its DVR transport remains authoritative")
        function _()
            live = new TransportController.Controller()
            live.SetContent(true, 2000, true)
            live.SetLiveDvrWindow(120000)
            live.OnLiveEdge(300000)
            live.OnPosition(295000)
            live.OnReady()

            live.HandleCommand(TransportController.Command.SkipBack10)
            m.assertInvalid(live.TakeVideoIntent())
            m.assertEqual(live.transportMode, TransportController.Mode.Idle)
            m.assertEqual(live.positionMs, 295000)
            m.assertEqual(live.cursorMs, 295000)
            m.AssertInvariants(live)
        end function

        private function FreshVod(positionMs as integer, durationMs as integer) as object
            controller = new TransportController.Controller()
            controller.SetContent(false, 2000, true)
            controller.OnDuration(durationMs)
            controller.OnPosition(positionMs)
            controller.OnReady()
            return controller
        end function

        private function AssertInvariants(controller as object) as void
            snapshot = {
                transportMode: controller.transportMode
                glyph: controller.glyph
                scanLevel: controller.scanLevel
                scanDir: controller.scanDir
                scrubHeldDir: controller.scrubHeldDir
                scrubHoldTicks: controller.scrubHoldTicks
                scrubStepMs: controller.scrubStepMs
                storyboardStepMs: controller.storyboardStepMs
                cursorMs: controller.cursorMs
                positionMs: controller.positionMs
                durationMs: controller.durationMs
                edgeMs: controller.edgeMs
                liveOffsetMs: controller.liveOffsetMs
                atLiveEdge: controller.atLiveEdge
                isLive: controller.isLive
                replayPending: controller.replayPending
            }
            result = PlayerInvariants.CheckBrain(snapshot)
            m.assertTrue(result.ok, result.failed)
        end function

    end class

end namespace
